# Copy this file to .env.local and fill in real values.

# Public base URL, used for metadata and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (Project Settings -> API). Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
